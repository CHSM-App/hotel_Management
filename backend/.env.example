# Copy to .env and fill in real values.
#
# The app validates all of this at startup and refuses to boot if something
# required is missing — see src/config/env.js. A broken environment fails loudly
# on the way up rather than as a 500 on someone's first sign-in.
DB_NAME=
DB_USER=
DB_PASSWORD=

DB_SERVER=
DB_PORT=


# Signs session tokens. Minimum 32 characters — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, which is the intended way to revoke every
# session at once.
JWT_SECRET=
PORT=5000
NODE_ENV=development

# Where uploaded files are written: guest ID proofs, room photos, dish photos.
#
# REQUIRED IN PRODUCTION, and it must point OUTSIDE the application directory.
# The deploy replaces the whole of backend/ on every push, so anything stored
# inside it is destroyed — including KYC documents the property is required to
# retain. On cPanel use something like /home/<account>/lms-uploads.
#
# Leave blank in development and it falls back to backend/uploads/.
UPLOAD_ROOT=

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal. Defaults to info in production,
# debug elsewhere. Logs are JSON on stdout; under Passenger that lands in the
# app's log file, so configure rotation there.
LOG_LEVEL=info

# --- HTTPS -----------------------------------------------------------------
# Set to "true" ONLY once the site reliably serves HTTPS. It tells browsers to
# refuse plain HTTP for this domain, and they remember it for six months — so
# enabling it early locks visitors out of a working site and cannot be undone
# by simply switching it back off.
ENABLE_HSTS=fals

# --- Database tuning -------------------------------------------------------
# All optional; the defaults shown are what the app uses when these are unset.
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MAX=10

# Set to "false" when SQL Server is on a DIFFERENT host and presents a
# certificate the app can verify. Leaving it unset trusts any certificate,
# which means the connection is encrypted but not authenticated — fine when the
# database is on the same machine, unsafe across a network.
DB_TRUST_SERVER_CERT=

# Exact origins allowed in production. Outside production any loopback or
# private-LAN origin is accepted on any port, so a phone on the office Wi-Fi can
# reach the dev server whichever port Vite ends up on.
ALLOWED_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app. Set to 1 for a single nginx or
# Passenger; 2 if Cloudflare sits in front of that. REQUIRED in production — the
# app refuses to start without it.
#
# Without it every request appears to come from the proxy, so the rate limiters
# bucket the entire property under one address: any guest could then block food
# ordering for everyone by failing fifty PIN attempts. Set it too high and you
# trust a hop that does not exist, which can be forged — so match your actual
# setup rather than guessing upward.
TRUST_PROXY=

# ----------------------------------------------------------




 
# WhatsApp OTP (SMSala) — replace with real values before production
WHATSAPP_API_TOKEN=
WHATSAPP_OTP_TEMPLATE_ID=

# First SUPERADMIN account, created by npm run db:init. Unset after
# the account exists so the script doesn't keep trying to recreate it.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=