# Copy to .env and fill in real values.

DB_NAME=
DB_USER=
DB_PASSWORD=

DB_SERVER=
DB_PORT=

JWT_SECRET=
PORT=5000
NODE_ENV=development

# Exact origins allowed in production. Outside production any loopback or
# private-LAN origin is accepted on any port, so a phone on the office Wi-Fi can
# reach the dev server whichever port Vite ends up on.
ALLOWED_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (1 for a single nginx). Required
# in production so the public ordering rate limiter sees real client IPs instead
# of the proxy's. Leave unset when running the API directly.
TRUST_PROXY=

# WhatsApp OTP (SMSala) — replace with real values before production
WHATSAPP_API_TOKEN=
WHATSAPP_OTP_TEMPLATE_ID=

# First SUPERADMIN account, created by `npm run db:init`.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=
