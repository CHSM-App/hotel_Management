<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / iisnode configuration for the deployed app.

  The CI deploy pushes the contents of backend/ to the `backend` branch, so this
  file lands at the branch root next to app.js — which is where IIS looks for it.

  This exists because the deploy force-pushes a fresh snapshot over the site
  directory. Anything that lives only on the server is destroyed on the next
  release, so the server configuration has to be in the repository or the site
  breaks every time someone deploys.
-->
<configuration>
  <system.webServer>

    <!--
      Hands every request that reaches app.js to iisnode, which owns the node
      process and proxies to it over a named pipe. Without this handler IIS
      treats app.js as a file to serve or refuses it outright, and the site
      answers 500 with an empty body before node is ever started.
    -->
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!--
          iisnode's own diagnostics live under /iisnode; leaving them
          un-rewritten is what makes the logs reachable when node fails to
          boot. Everything else falls through to the app.
        -->
        <rule name="iisnode-logs" stopProcessing="true">
          <match url="^iisnode.*" />
          <action type="None" />
        </rule>

        <!--
          Everything else goes to node — including static assets.

          Deliberately no IIS static-file rule: express.static already serves
          the built SPA from src/public, and it also serves /room-images and
          /menu-images out of UPLOAD_ROOT, which points *outside* the site
          directory. IIS cannot serve those paths, so letting it try would
          404 every uploaded image and break the SPA fallback that turns a
          deep link like /bookings-overview into index.html.
        -->
        <rule name="node-app">
          <match url="/*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!--
      loggingEnabled writes stdout/stderr to iisnode/*.log under the site
      directory. This is how the startup env check's "Refusing to start" block
      becomes readable — without it a failed boot is a blank 500 with no
      explanation anywhere.

      nodeProcessCommandLine is intentionally omitted so iisnode uses the node
      version Plesk has registered for the site. Set it to an explicit path only
      if the site needs a version other than the default.
    -->
    <iisnode
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      nodeProcessCountPerApplication="1" />

    <!--
      The SPA bundle and uploaded images are large enough that IIS's 30 MB
      default is not the binding limit, but ID-proof uploads are: multer caps
      them well below this, and IIS rejecting the request first would surface as
      a bare 404.13 instead of the app's own validation message.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <!--
      IIS must not add its own error bodies on top of the app's JSON responses;
      the SPA parses error payloads and an IIS HTML page breaks that.
    -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
