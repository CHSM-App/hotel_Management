<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS + iisnode hosting configuration.

  The CI deploy pushes the contents of backend/ to the `backend` branch, so this
  file lands at the branch root alongside app.js — which is where IIS looks for
  it. It is the IIS counterpart of the cPanel/Passenger setup described in
  app.js: both boot the same entry point, so the two can coexist.

  Every request is rewritten to app.js. Express then serves the SPA out of
  src/public, the API under /auth, /rooms, … and the uploads directory — all on
  one origin, which is what the frontend's empty VITE_API_URL assumes.
-->
<configuration>
  <system.webServer>
    <!-- Let Express's error handler own the response body; without this IIS
         replaces JSON error payloads with its own HTML error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <add name="Connection" value="keep-alive" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <verbs>
          <!-- CORS preflight: the API is called cross-origin in development. -->
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <tracing>
      <traceFailedRequests>
        <clear/>
      </traceFailedRequests>
    </tracing>

    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode"/>
    </handlers>

    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^app.js\/debug[\/]?"/>
        </rule>
        <rule name="Node.js" stopProcessing="true">
          <match url="(.*)"/>
          <action type="Rewrite" url="app.js"/>
        </rule>
      </rules>
    </rewrite>

    <iisnode
      devErrorsEnabled="false"
      debuggingEnabled="false"
      loggingEnabled="true"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="200"
      namedPipeConnectionRetryDelay="250"
      maxNamedPipeConnectionPoolSize="512"
      maxNamedPipePooledConnectionAge="60000"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="*.js;src\*.js;src\**\*.js;node_modules\*"
      recycleSignalEnabled="false"
    />

    <directoryBrowse enabled="false"/>
  </system.webServer>

  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\vengurlatech.com\tmp"/>
  </system.web>
</configuration>
