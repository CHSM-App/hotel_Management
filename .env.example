# Copy to .env and fill in real values.
#
# The app validates all of this at startup and refuses to boot if something
# required is missing — see src/config/env.js. A broken environment fails loudly
# on the way up rather than as a 500 on someone's first sign-in.
DB_NAME=
DB_USER=
DB_PASSWORD=

DB_SERVER=
DB_PORT=


# Signs session tokens. Minimum 32 characters — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, which is the intended way to revoke every
# session at once.
JWT_SECRET=
# PORT is ignored under IIS/iisnode and Passenger: both hand the app a port (a
# named pipe, in the IIS case) through this same variable, and the value here
# does not override it - dotenv never overwrites a variable the host already
# set. It only matters for `npm run dev`.
PORT=5000

# Setting this to `production` switches on two additional REQUIRED variables:
# ALLOWED_ORIGINS and TRUST_PROXY. The app refuses to boot without them -
# deliberately, but the refusal is a process exit, so on IIS it surfaces only as
# a blank HTTP 500 on every request. If a production deployment returns 500
# everywhere, check those two first.
NODE_ENV=development

# Where uploaded files are written: guest ID proofs, room photos, dish photos.
#
# OPTIONAL, in every environment. Left blank, uploads are rooted at
# backend/uploads/ — in-tree, next to the app, the same way the
# college-admission backend roots BackEnd/uploads/students. The folder is
# gitignored, so a deploy that pulls or checks out the backend branch leaves it
# untouched.
#
# Because the files live inside backend/, never deploy with a clean wipe
# (`git clean -xdf`, or delete-then-copy) and do back the folder up: guest ID
# proofs are KYC documents the property is legally required to retain.
#
# Set it only to move uploads onto another volume, e.g.
#   UPLOAD_ROOT=C:\Inetpub\vhosts\vengurlatech.com\lms-uploads
# The application pool identity needs Modify rights on whichever path is used —
# the app creates its sub-folders at startup and cannot boot if that fails.
UPLOAD_ROOT=

# --- Logging ---------------------------------------------------------------
# trace | debug | info | warn | error | fatal. Defaults to info in production,
# debug elsewhere. Logs are JSON on stdout; under Passenger that lands in the
# app's log file, so configure rotation there.
LOG_LEVEL=info

# --- HTTPS -----------------------------------------------------------------
# Set to "true" ONLY once the site reliably serves HTTPS. It tells browsers to
# refuse plain HTTP for this domain, and they remember it for six months — so
# enabling it early locks visitors out of a working site and cannot be undone
# by simply switching it back off.
ENABLE_HSTS=fals

# --- Database tuning -------------------------------------------------------
# All optional; the defaults shown are what the app uses when these are unset.
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_POOL_MAX=10

# Set to "false" when SQL Server is on a DIFFERENT host and presents a
# certificate the app can verify. Leaving it unset trusts any certificate,
# which means the connection is encrypted but not authenticated — fine when the
# database is on the same machine, unsafe across a network.
DB_TRUST_SERVER_CERT=

# Exact origins allowed in production. Outside production any loopback or
# private-LAN origin is accepted on any port, so a phone on the office Wi-Fi can
# reach the dev server whichever port Vite ends up on.
# In production set it to the deployed origin, comma-separated if there is more
# than one, with no trailing slash — e.g.
#   ALLOWED_ORIGINS=https://lodge.vengurlatech.com
ALLOWED_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app. Set to 1 for a single nginx or
# Passenger; 2 if Cloudflare sits in front of that. REQUIRED in production — the
# app refuses to start without it. Under IIS/iisnode the value is 1: IIS itself
# is the one hop in front of the node process.
#
# Without it every request appears to come from the proxy, so the rate limiters
# bucket the entire property under one address: any guest could then block food
# ordering for everyone by failing fifty PIN attempts. Set it too high and you
# trust a hop that does not exist, which can be forged — so match your actual
# setup rather than guessing upward.
TRUST_PROXY=

# ----------------------------------------------------------




 
# WhatsApp (SMSala).
#
# The token is the account credential from api2.smsala.com. It is REQUIRED for
# staff password changes: changing a password needs a one-time code delivered
# to the account's own phone, so with no token set here that flow answers 503
# and nobody can change their password.
#
# The OTP template id is the approved OTP template; leave it blank only if the
# provider account has a default OTP template configured.
WHATSAPP_API_TOKEN=
WHATSAPP_OTP_TEMPLATE_ID=

# Booking confirmations to guests, for room stays. OPTIONAL: leave blank and
# no message goes out; set it to the id of the approved "your booking is
# confirmed" template and every new stay sends the guest a WhatsApp message.
# The template must take exactly ten variables, in this order:
#   {{1}} name                {{6}} advance
#   {{2}} hotel_name          {{7}} balance (total minus advance)
#   {{3}} room                {{8}} "Download your advance receipt here: "
#   {{4}} checkin_at                followed by the link — label and link
#   {{5}} checkout_at               both, generated automatically. No
#                                    advance taken and this slot carries no
#                                    readable text, rather than the label
#                                    pointing at a dash
#                              {{9}} directions (Maps link from the
#                                    property's coordinates, else address)
#                              {{10}} contact (property phone)
# No booking id — the system never shows a guest their booking id anywhere
# else, so {{3}} is the room number(s) instead.
# Sends are best-effort: a failure is logged (level warn) and the booking
# stands. The desk is not told in the UI; check the log.
WHATSAPP_BOOKING_TEMPLATE_ID=

# Booking confirmations to organisers, for Events & Functions — a function's
# own template rather than reusing the stay template above, since a function's
# shape (venue, a single date, a start-end time range) read wrong wedged into
# the stay wording. OPTIONAL: leave blank and no message goes out; set it to
# the id of the approved "your event booking is confirmed" template and every
# function that takes its venue (created as or moved to CONFIRMED — a draft is
# not told "confirmed") sends the organiser a WhatsApp message. The template
# must take exactly ten variables, in this order:
#   {{1}} organiser name   {{6}} advance paid
#   {{2}} property name    {{7}} total amount
#   {{3}} venue name        {{8}} balance due (total minus advance)
#   {{4}} event date         {{9}} directions (Maps link from the
#   {{5}} time range (start - end)   property's coordinates, else address)
#                            {{10}} property phone
# Sends are best-effort: a failure is logged (level warn) and the booking
# stands. The desk is not told in the UI; check the log.
WHATSAPP_EVENT_BOOKING_TEMPLATE_ID=

# Sending a bill to a guest from the billing screen. OPTIONAL: leave blank and
# the Share menu shows WhatsApp as unavailable, and nothing else changes. Set it
# to the id of the approved "here is your bill" template and the desk can send
# the bill it is looking at straight to the guest's number. The template must
# take exactly seven variables, in this order:
#   {{1}} guest name        {{5}} check-in date
#   {{2}} property name     {{6}} check-out date
#   {{3}} booking / bill id {{7}} link to the bill PDF
#   {{4}} amount (Rs 1234.50 - plain digits, because the provider separates
#         template variables with commas and a thousands separator would shift
#         every variable after it)
# Unlike the booking confirmation, a failure here is reported to the desk: this
# is the action they asked for, not a message riding along with something else.
WHATSAPP_BILL_TEMPLATE_ID=

# Sending an Events & Functions final bill from the same billing screen.
# OPTIONAL: leave blank and the Share menu shows WhatsApp as unavailable for
# that invoice, same as the stay bill above. Set it to the id of the approved
# "here is your event bill" template and the desk can send a function's
# final bill straight to the organiser's number with the same "Share on
# WhatsApp" press used for a room bill — shareInvoiceOnWhatsApp
# (billShare.service.js) tells the two apart from the invoice itself (an
# event_booking_id behind it, not a booking_id) and picks this template
# instead of the one above. The template must take exactly seven variables,
# in this order:
#   {{1}} organiser name    {{5}} event date
#   {{2}} property name     {{6}} total amount (plain digits, same reason as
#   {{3}} bill number              the stay bill's {{4}} above)
#   {{4}} venue name         {{7}} link to the bill PDF
# Unlike the booking confirmation, a failure here is reported to the desk:
# this is the action they asked for, not a message riding along with
# something else.
WHATSAPP_EVENT_BILL_TEMPLATE_ID=

# Cancelling a booking. OPTIONAL: leave blank and no message goes out. Set it
# to the id of the approved "your booking is cancelled" template and every
# cancellation sends the guest a WhatsApp message. The template must take
# exactly seven variables, in this order:
#   {{1}} guest name        {{5}} check-out date
#   {{2}} property name     {{6}} cancellation reason
#   {{3}} room number       {{7}} refund / charge amount and payment method
#   {{4}} check-in date           (or "No refund due" if neither applies)
# Sends are best-effort: a failure is logged (level warn) and the cancellation
# stands. The desk is not told in the UI; check the log.
WHATSAPP_CANCELLATION_TEMPLATE_ID=

# Cancelling an Events & Functions booking. OPTIONAL: leave blank and no
# message goes out. Set it to the id of the approved "your event booking is
# cancelled" template and every cancellation sends the organiser a WhatsApp
# message. Its own approval, separate from the stay cancellation above — a
# function names a venue and a single date rather than a room number and a
# check-in/check-out pair. The template must take exactly seven variables,
# in this order:
#   {{1}} organiser name   {{5}} cancellation reason
#   {{2}} property name    {{6}} refund / charge amount and payment method
#   {{3}} venue name              (or "No refund due" if neither applies)
#   {{4}} event date        {{7}} property phone
# Sends are best-effort: a failure is logged (level warn) and the cancellation
# stands. The desk is not told in the UI; check the log.
WHATSAPP_EVENT_CANCELLATION_TEMPLATE_ID=

# Sending an advance receipt to a guest from the advance-receipt screen.
# OPTIONAL: leave blank and the Share menu shows WhatsApp as unavailable, same
# as the bill template above. Set it to the id of the approved "here is your
# receipt" template and the desk can send the receipt it is looking at
# straight to the guest's number. The template must take exactly six
# variables, in this order:
#   {{1}} guest name        {{4}} amount received (Rs 1234.50 - plain digits,
#   {{2}} property name           same reason as the bill template)
#   {{3}} receipt number     {{5}} payment method (Cash / UPI / Card)
#                            {{6}} link to the receipt PDF
# Unlike the bill template, there is no separate event-only receipt template:
# the message names no room number, check-in/check-out, or venue, so this one
# template already covers an advance taken against either a room stay or an
# Events & Functions booking.
# Unlike the booking confirmation, a failure here is reported to the desk: this
# is the action they asked for, not a message riding along with something else.
WHATSAPP_RECEIPT_TEMPLATE_ID=

# Welcoming a guest once they're checked in. OPTIONAL: leave blank and no
# message goes out. Set it to the id of the approved "welcome" template and
# every check-in sends the guest a WhatsApp message. The template must take
# exactly five variables, in this order:
#   {{1}} guest name        {{4}} check-out date
#   {{2}} property name     {{5}} property phone number
#   {{3}} room number
# Sends are best-effort: a failure is logged (level warn) and the check-in
# stands. The desk is not told in the UI; check the log.
WHATSAPP_CHECKIN_TEMPLATE_ID=

# Reminding a guest their stay is coming up. OPTIONAL: leave blank and no
# message goes out, and the daily sweep does nothing at all (it checks this
# before it even queries for bookings). Set it to the id of the approved
# "your stay is coming up" template and a background job sends it once per
# booking, either 3 days or 1 day before check-in depending on how far ahead
# the booking was made — see reminderKind in stayReminders.service.js for the
# exact rule. The template must take exactly six variables, in this order:
#   {{1}} guest name        {{4}} check-in date
#   {{2}} property name     {{5}} check-out date
#   {{3}} "in 3 days" / "tomorrow"  {{6}} property phone number
# Sends are best-effort: a failure is logged (level warn) and the booking is
# still marked reminded, so it is never retried. Runs at 9 AM IST daily.
WHATSAPP_REMINDER_TEMPLATE_ID=

# Reminding an organiser their Events & Functions booking is coming up.
# OPTIONAL: leave blank and no message goes out, and the daily sweep does
# nothing at all (it checks this before it even queries for functions). Set
# it to the id of the approved "your event is coming up" template and a
# background job sends it once per function, exactly one day before the
# event — unlike the stay reminder above, there is only ever the one moment
# here, no lead-time branching. Only a CONFIRMED function (one that has
# actually taken its venue) is ever reminded. The template must take exactly
# seven variables, in this order:
#   {{1}} organiser name   {{5}} event date
#   {{2}} property name    {{6}} event time
#   {{3}} "tomorrow"         {{7}} property phone number
#   {{4}} venue name
# Sends are best-effort: a failure is logged (level warn) and the function is
# still marked reminded, so it is never retried. Runs at 9 AM IST daily.
WHATSAPP_EVENT_REMINDER_TEMPLATE_ID=

# Telling an organiser their Events & Functions booking changed. OPTIONAL:
# leave blank and no message goes out. Set it to the id of the approved
# "your event has been rescheduled" template and an edit that moves a
# confirmed function's venue or date/time sends the organiser a WhatsApp
# message — the same check updateEventBooking already makes before re-running
# its clash check, so this never fires for an edit to pax or pricing alone,
# and never for a function that was never confirmed in the first place. The
# template must take exactly six variables, in this order:
#   {{1}} organiser name   {{4}} new date
#   {{2}} property name    {{5}} new time
#   {{3}} venue name        {{6}} property phone
# Sends are best-effort: a failure is logged (level warn) and the edit
# stands. The desk is not told in the UI; check the log.
WHATSAPP_EVENT_RESCHEDULE_TEMPLATE_ID=

# Asking a guest for feedback a few hours after checkout — or, since
# eventFeedbackRequests.service.js, asking an organiser once their function
# is marked complete; one template and one env var cover both, since neither
# names a room or a venue. OPTIONAL: leave blank and no message goes out, and
# both sweeps do nothing at all (each checks this before it even queries).
# Set it to the id of the approved "please share your feedback" template and
# a background job sends it once per booking or function — see DELAY_HOURS in
# feedbackRequests.service.js / eventFeedbackRequests.service.js. The link in
# the message opens a page this app hosts itself (no owner-supplied review
# URL to configure), so this also needs PUBLIC_BASE_URL set below. The
# template must take exactly two variables, in this order:
#   {{1}} guest / organiser name
#   {{2}} greet_message — an opening line that reads right for a stay or a
#         function (picked by the `kind` each sweep passes), then the ask
#         and the feedback link, all composed server-side as one block (see
#         buildGreetMessage in feedbackRequest.js). An earlier three-variable
#         version of this template was rejected by WhatsApp's reviewers;
#         collapsing the last two variables into one, with no two
#         placeholders left adjacent, is what passed approval.
# Sends are best-effort: a failure is logged (level warn); either way the
# booking or function is never asked twice. Checked every 2 hours.
WHATSAPP_FEEDBACK_TEMPLATE_ID=

# Wishing a customer a happy birthday. OPTIONAL: leave blank and no message
# goes out, and the daily sweep does nothing at all (it checks this before
# it even queries for customers). Set it to the id of the approved
# "happy birthday" template and a background job sends it once a year to
# every customer whose date of birth is on file and matches today — see
# birthdayWishes.service.js. Date of birth is entered by hand on a
# customer's profile (Customers tab); nothing here infers it automatically.
# The template must take exactly two variables, in this order:
#   {{1}} customer name  {{2}} property name
# Sends are best-effort: a failure is logged (level warn); either way the
# customer isn't wished again until next year. Runs at 9 AM IST daily.
WHATSAPP_BIRTHDAY_TEMPLATE_ID=

# Where guests reach this site from their own phones. REQUIRED to share a
# bill or an advance receipt on WhatsApp, or to send the post-checkout
# feedback link above; optional otherwise.
#
# A bill (or the feedback page) goes out as a link, so this has to be an
# address that resolves on mobile data - the public https:// origin, not the
# LAN address the desk's browser uses. It is configured rather than read off
# the request's Host header because behind a proxy that header is whatever
# the proxy was asked for, and a link built from it can point somewhere the
# guest cannot reach.
#   e.g. PUBLIC_BASE_URL=https://hotel.vengurlatech.com
PUBLIC_BASE_URL=

# First SUPERADMIN account, created by npm run db:init. Unset after
# the account exists so the script doesn't keep trying to recreate it.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=